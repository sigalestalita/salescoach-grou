{
  "manifest_version": 3,
  "name": "Sales Coach AI - Gravador de Reuniões",
  "version": "1.5.0",
  "description": "Grave suas reuniões comerciais com tela e áudio, com coaching ao vivo em tempo real.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://xgpfuunmmjkgwjefofcd.supabase.co/*",
    "https://xgpfuunmmjkgwjefofcd.functions.supabase.co/*",
    "wss://xgpfuunmmjkgwjefofcd.functions.supabase.co/*",
    "wss://xgpfuunmmjkgwjefofcd.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
