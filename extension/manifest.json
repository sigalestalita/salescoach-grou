{
  "manifest_version": 3,
  "name": "Sales Coach — Gravador e Coach ao Vivo",
  "version": "1.6.0",
  "description": "Grave reuniões no Meet e no Teams e receba orientação ao vivo, na tela, pela metodologia da sua empresa.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://xgpfuunmmjkgwjefofcd.supabase.co/*",
    "https://xgpfuunmmjkgwjefofcd.functions.supabase.co/*",
    "wss://xgpfuunmmjkgwjefofcd.functions.supabase.co/*",
    "wss://xgpfuunmmjkgwjefofcd.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
