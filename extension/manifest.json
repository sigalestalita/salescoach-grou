{
  "manifest_version": 3,
  "name": "Sales Coach — Gravador e Coach ao Vivo",
  "version": "1.10.3",
  "description": "Grave reuniões no Meet e no Teams com um clique e receba dicas ao vivo, pela metodologia da sua empresa.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://xgpfuunmmjkgwjefofcd.supabase.co/*",
    "https://xgpfuunmmjkgwjefofcd.functions.supabase.co/*",
    "wss://xgpfuunmmjkgwjefofcd.functions.supabase.co/*",
    "wss://xgpfuunmmjkgwjefofcd.supabase.co/*",
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "wss://streaming.assemblyai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "autodetect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.grougp.com.br/*"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
